---
import { t, type Locale } from '../../i18n';
import { platforms, RELEASES_URL } from '../../data/downloads';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<h1>{t(locale, 'dl.title')}</h1>
<p class="muted">{t(locale, 'dl.desc')}</p>
<div class="grid grid-platforms">
  {platforms.map((p) => (
    <div class="card card-platform">
      <h3>{t(locale, p.labelKey)}</h3>
      <a href={`${RELEASES_URL}/latest`} target="_blank" rel="noopener" aria-label={`${t(locale, p.labelKey)} releases`}>{t(locale, 'dl.latest')}</a>
    </div>
  ))}
</div>
