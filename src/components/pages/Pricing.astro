---
import { t, type Locale } from '../../i18n';
import { editions, capabilityKeys } from '../../data/editions';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<h1>{t(locale, 'pricing.title')}</h1>
<div class="card">
  <table>
    <thead>
      <tr>
        <th></th>
        {editions.map((e) => <th>{t(locale, 'ed.' + e.id)}</th>)}
      </tr>
    </thead>
    <tbody>
      {capabilityKeys.map((cap) => (
        <tr>
          <th>{t(locale, cap)}</th>
          {editions.map((e) => <td>{e.featureKeys.includes(cap) ? '✓' : '—'}</td>)}
        </tr>
      ))}
    </tbody>
  </table>
</div>
