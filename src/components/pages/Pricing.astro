---
import { t, type Locale } from '../../i18n';
import { editions, capabilityKeys } from '../../data/editions';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<h1>{t(locale, 'pricing.title')}</h1>
<table style="width:100%;border-collapse:collapse">
  <thead>
    <tr>
      <th></th>
      {editions.map((e) => <th style="border:1px solid var(--border);padding:.5rem">{t(locale, 'ed.' + e.id)}</th>)}
    </tr>
  </thead>
  <tbody>
    {capabilityKeys.map((cap) => (
      <tr>
        <th style="border:1px solid var(--border);padding:.5rem;text-align:left">{t(locale, cap)}</th>
        {editions.map((e) => (
          <td style="border:1px solid var(--border);padding:.5rem;text-align:center">
            {e.featureKeys.includes(cap) ? '✓' : '—'}
          </td>
        ))}
      </tr>
    ))}
  </tbody>
</table>
