---
import { t, altPath, type Locale } from '../i18n';
import { translateUrl } from '../i18n/paths';
import ThemeToggle from './ThemeToggle.astro';

interface Props { locale: Locale; path: string; }
const { locale, path } = Astro.props;
const nav = [['/', 'nav.home'], ['/pricing', 'nav.pricing'], ['/download', 'nav.download'], ['/about', 'nav.about']] as const;
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={translateUrl('/', locale)}>
      <img src="/tokenmate-icon.svg" width="30" height="27" alt="" aria-hidden="true" />
      TokenMate
    </a>
    <div class="nav-actions">
      <nav class="site-nav">
        {nav.map(([href, key]) => <a href={translateUrl(href, locale)}>{t(locale, key)}</a>)}
        <a href={altPath(locale, path)} hreflang={locale === 'en' ? 'zh' : 'en'}>{t(locale, 'nav.langSwitch')}</a>
      </nav>
      <ThemeToggle locale={locale} />
    </div>
  </div>
</header>
